# Copy to .env (untracked) and fill in locally. NEVER commit .env or paste secrets in chat.

APP_ENV=local
DATABASE_URL=postgresql+psycopg://elide:elide_local_dev_only@127.0.0.1:5433/elide
# Optional overrides for compose.yaml
# POSTGRES_PASSWORD=elide_local_dev_only
# ELIDE_DB_PORT=5433  (5432 is often taken by a WSL or native PostgreSQL)

# --- PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
# Sandbox only. There is intentionally no live/production setting.
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret
# Email of your Sandbox *personal* (payer) test account
PAYPAL_SANDBOX_PAYER_EMAIL=replace-with-sandbox-personal-account-email
# Filled in Phase 5 when webhooks are configured
PAYPAL_WEBHOOK_ID=

# --- LLM adapter (Phase 3): OpenAI-compatible provider, e.g. Nebius Token Factory ---
# LLM_PROVIDER=nebius uses https://api.tokenfactory.nebius.com/v1/ and the default model in
# api/ai/openai_compat.py unless LLM_BASE_URL / LLM_MODEL are set. The model gets no tools
# and no payment access. Spend is capped (estimate) at LLM_SPEND_CAP_USD.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Only needed for a model without a built-in price entry (USD per 1M tokens)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
LLM_SPEND_CAP_USD=10.00
